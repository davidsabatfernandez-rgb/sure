<div class="pb-6 lg:pb-12 space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-medium text-primary"><%= t("financial_roadmap.show.title") %></h1>
  </div>

  <%# Timeline visualization %>
  <div class="bg-container rounded-xl shadow-border-xs p-6 space-y-4">
    <h2 class="text-lg font-medium text-primary"><%= t("financial_roadmap.show.timeline") %></h2>

    <% if @milestones.any? %>
      <div class="space-y-3">
        <% @milestones.each do |milestone| %>
          <div class="bg-surface-inset rounded-xl p-4 space-y-3">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full shrink-0" style="background-color: <%= milestone.status_color %>"></div>
                  <h3 class="font-medium text-primary"><%= milestone.nombre %></h3>
                  <span class="text-xs px-2 py-0.5 rounded-full bg-container text-secondary">
                    <%= t("financial_roadmap.show.estados.#{milestone.estado}") %>
                  </span>
                </div>
                <% if milestone.descripcion.present? %>
                  <p class="text-sm text-secondary mt-1 ml-5"><%= milestone.descripcion %></p>
                <% end %>
              </div>

              <div class="flex items-center gap-2 shrink-0 ml-4">
                <%# Inline edit form for monto_actual %>
                <%= styled_form_with model: milestone,
                  url: financial_roadmap_milestone_path(milestone),
                  method: :patch,
                  class: "flex items-center gap-2" do |f| %>
                  <div class="flex items-center gap-1">
                    <%= f.number_field :monto_actual,
                      value: milestone.monto_actual.to_f,
                      step: 0.01,
                      class: "w-24 text-right text-sm px-2 py-1 rounded-lg bg-container shadow-border-xs text-primary",
                      data: { action: "change->auto-submit-form#submit" } %>
                    <span class="text-sm text-secondary">/ <%= number_to_currency(milestone.monto_objetivo, unit: "\u20AC", format: "%n %u") %></span>
                  </div>
                <% end %>

                <%= button_to financial_roadmap_milestone_path(milestone),
                  method: :delete,
                  class: "text-secondary hover:text-destructive transition-colors",
                  data: { turbo_confirm: t("financial_roadmap.show.confirm_delete") } do %>
                  <%= icon("trash-2", size: "sm") %>
                <% end %>
              </div>
            </div>

            <%# Progress bar %>
            <div class="space-y-1">
              <div class="flex justify-between text-xs text-secondary">
                <span><%= milestone.fecha_inicio.strftime("%d/%m/%Y") %></span>
                <span class="font-medium" style="color: <%= milestone.status_color %>">
                  <%= milestone.progreso_pct %>%
                </span>
                <span><%= milestone.fecha_objetivo.strftime("%d/%m/%Y") %></span>
              </div>
              <div class="w-full bg-container rounded-full h-3 overflow-hidden">
                <div class="h-full rounded-full transition-all duration-500"
                     style="width: <%= milestone.progreso_pct %>%; background-color: <%= milestone.status_color %>">
                </div>
              </div>
              <div class="flex justify-between text-xs text-secondary">
                <span>
                  <% if milestone.dias_restantes > 0 %>
                    <%= t("financial_roadmap.show.days_remaining", count: milestone.dias_restantes) %>
                  <% elsif milestone.dias_restantes == 0 %>
                    <%= t("financial_roadmap.show.due_today") %>
                  <% else %>
                    <%= t("financial_roadmap.show.overdue", count: milestone.dias_restantes.abs) %>
                  <% end %>
                </span>
                <span>
                  <% if milestone.on_track? && milestone.estado != "completado" %>
                    <%= icon("check-circle", size: "sm", class: "inline text-success") %>
                    <%= t("financial_roadmap.show.on_track") %>
                  <% elsif milestone.estado == "completado" %>
                    <%= icon("circle-check", size: "sm", class: "inline text-secondary") %>
                    <%= t("financial_roadmap.show.completed") %>
                  <% else %>
                    <%= icon("alert-triangle", size: "sm", class: "inline text-warning") %>
                    <%= t("financial_roadmap.show.behind") %>
                  <% end %>
                </span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <p class="text-secondary"><%= t("financial_roadmap.show.empty") %></p>
      </div>
    <% end %>
  </div>

  <%# Add new milestone form %>
  <div class="bg-container rounded-xl shadow-border-xs p-6 space-y-4">
    <h2 class="text-lg font-medium text-primary"><%= t("financial_roadmap.show.add_milestone") %></h2>

    <%# Quick suggestions %>
    <div class="flex flex-wrap gap-2" data-controller="roadmap-suggestions">
      <% [
        { nombre: "Liquidar coche", monto: 9500 },
        { nombre: "Colch\u00F3n emergencia 15k", monto: 15000 },
        { nombre: "Obra Iglesia", monto: 100000 },
        { nombre: "Compra planta Calders", monto: 50000 }
      ].each do |suggestion| %>
        <button type="button"
                class="text-xs px-3 py-1.5 rounded-full bg-surface-inset text-secondary hover:text-primary hover:bg-container transition-colors shadow-border-xs"
                data-action="click->roadmap-suggestions#fill"
                data-roadmap-suggestions-nombre-param="<%= suggestion[:nombre] %>"
                data-roadmap-suggestions-monto-param="<%= suggestion[:monto] %>">
          <%= suggestion[:nombre] %> (<%= number_to_currency(suggestion[:monto], unit: "\u20AC", format: "%n %u") %>)
        </button>
      <% end %>
    </div>

    <%= styled_form_with model: @milestone,
      url: financial_roadmap_milestones_path,
      class: "space-y-4",
      data: { roadmap_suggestions_target: "form" } do |f| %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :nombre, t("financial_roadmap.show.form.nombre"), class: "block text-sm font-medium text-primary mb-1" %>
          <%= f.text_field :nombre,
            placeholder: t("financial_roadmap.show.form.nombre_placeholder"),
            class: "w-full rounded-lg bg-container shadow-border-xs px-3 py-2 text-sm text-primary",
            required: true,
            data: { roadmap_suggestions_target: "nombre" } %>
        </div>

        <div>
          <%= f.label :monto_objetivo, t("financial_roadmap.show.form.monto_objetivo"), class: "block text-sm font-medium text-primary mb-1" %>
          <%= f.number_field :monto_objetivo,
            placeholder: "0.00",
            step: 0.01,
            min: 0,
            class: "w-full rounded-lg bg-container shadow-border-xs px-3 py-2 text-sm text-primary",
            required: true,
            data: { roadmap_suggestions_target: "monto" } %>
        </div>

        <div>
          <%= f.label :fecha_inicio, t("financial_roadmap.show.form.fecha_inicio"), class: "block text-sm font-medium text-primary mb-1" %>
          <%= f.date_field :fecha_inicio,
            value: @milestone.fecha_inicio || Date.current,
            class: "w-full rounded-lg bg-container shadow-border-xs px-3 py-2 text-sm text-primary",
            required: true %>
        </div>

        <div>
          <%= f.label :fecha_objetivo, t("financial_roadmap.show.form.fecha_objetivo"), class: "block text-sm font-medium text-primary mb-1" %>
          <%= f.date_field :fecha_objetivo,
            value: @milestone.fecha_objetivo || 1.year.from_now.to_date,
            class: "w-full rounded-lg bg-container shadow-border-xs px-3 py-2 text-sm text-primary",
            required: true %>
        </div>
      </div>

      <div>
        <%= f.label :descripcion, t("financial_roadmap.show.form.descripcion"), class: "block text-sm font-medium text-primary mb-1" %>
        <%= f.text_area :descripcion,
          rows: 2,
          placeholder: t("financial_roadmap.show.form.descripcion_placeholder"),
          class: "w-full rounded-lg bg-container shadow-border-xs px-3 py-2 text-sm text-primary" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= f.label :monto_actual, t("financial_roadmap.show.form.monto_actual"), class: "block text-sm font-medium text-primary mb-1" %>
          <%= f.number_field :monto_actual,
            value: 0,
            step: 0.01,
            min: 0,
            class: "w-full rounded-lg bg-container shadow-border-xs px-3 py-2 text-sm text-primary" %>
        </div>

        <div>
          <%= f.label :estado, t("financial_roadmap.show.form.estado"), class: "block text-sm font-medium text-primary mb-1" %>
          <%= f.select :estado,
            RoadmapMilestone::ESTADOS.map { |e| [t("financial_roadmap.show.estados.#{e}"), e] },
            {},
            class: "w-full rounded-lg bg-container shadow-border-xs px-3 py-2 text-sm text-primary" %>
        </div>

        <div>
          <%= f.label :color, t("financial_roadmap.show.form.color"), class: "block text-sm font-medium text-primary mb-1" %>
          <%= f.color_field :color,
            value: "#3B82F6",
            class: "w-full h-[38px] rounded-lg bg-container shadow-border-xs px-1 py-1 cursor-pointer" %>
        </div>
      </div>

      <div class="flex justify-end">
        <%= render DS::Button.new(text: t("financial_roadmap.show.form.submit"), variant: "primary", size: "md") %>
      </div>
    <% end %>
  </div>
</div>
