<% content_for :breadcrumbs do %>
  <%= render "layouts/shared/breadcrumbs", breadcrumbs: [{ label: "Dashboard", href: root_path }, { label: "Flujo mensual" }] %>
<% end %>

<div class="space-y-6 max-w-screen-lg mx-auto py-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-primary">Flujo de caja mensual</h1>
      <p class="text-sm text-secondary">Solo Revolut + Sabadell (cuentas operativas)</p>
    </div>
  </div>

  <%# Monthly table %>
  <div class="bg-container shadow-border-xs rounded-xl p-4">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-secondary border-b border-tertiary">
            <th class="text-left py-3 px-3">Mes</th>
            <th class="text-right py-3 px-3">Ingresos</th>
            <th class="text-right py-3 px-3">Gastos</th>
            <th class="text-right py-3 px-3">Ahorro</th>
            <th class="text-right py-3 px-3">% ahorro</th>
            <th class="text-right py-3 px-3">Txs</th>
            <th class="text-left py-3 px-3 w-32">Balance</th>
          </tr>
        </thead>
        <tbody>
          <% @months.each do |m| %>
            <tr class="border-b border-tertiary hover:bg-surface-inset transition-colors <%= m[:month] == Date.current.strftime('%Y-%m') ? 'bg-blue-50' : '' %>">
              <td class="py-3 px-3 font-medium text-primary">
                <%= m[:label] %>
                <% if m[:month] == Date.current.strftime("%Y-%m") %>
                  <span class="text-xs px-1.5 py-0.5 bg-blue-100 text-blue-700 rounded-full ml-1">Actual</span>
                <% end %>
              </td>
              <td class="py-3 px-3 text-right text-success font-medium">
                <% if m[:ingresos] > 0 %>
                  <%= number_to_currency(m[:ingresos], unit: "", delimiter: ".", separator: ",") %> &euro;
                <% else %>
                  <span class="text-secondary">-</span>
                <% end %>
              </td>
              <td class="py-3 px-3 text-right text-destructive font-medium">
                <%= number_to_currency(m[:gastos], unit: "", delimiter: ".", separator: ",") %> &euro;
              </td>
              <td class="py-3 px-3 text-right font-bold <%= m[:ahorro] >= 0 ? 'text-success' : 'text-destructive' %>">
                <%= m[:ahorro] >= 0 ? "+" : "" %><%= number_to_currency(m[:ahorro], unit: "", delimiter: ".", separator: ",") %> &euro;
              </td>
              <td class="py-3 px-3 text-right">
                <% if m[:ahorro_pct] > 0 %>
                  <span class="text-xs px-2 py-1 rounded-full font-semibold <%= m[:ahorro_pct] >= 40 ? 'bg-green-100 text-green-800' : m[:ahorro_pct] >= 20 ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' %>">
                    <%= m[:ahorro_pct] %>%
                  </span>
                <% else %>
                  <span class="text-secondary">-</span>
                <% end %>
              </td>
              <td class="py-3 px-3 text-right text-secondary"><%= m[:num_tx] %></td>
              <td class="py-3 px-3">
                <% max_val = @months.map { |x| [x[:ingresos], x[:gastos]].max }.max %>
                <% if max_val > 0 && m[:ingresos] > 0 %>
                  <div class="flex h-4 rounded-full overflow-hidden w-full">
                    <div class="bg-green-400" style="width: <%= (m[:ingresos] / max_val * 100).round %>%"></div>
                  </div>
                  <div class="flex h-4 rounded-full overflow-hidden w-full mt-0.5">
                    <div class="bg-red-300" style="width: <%= (m[:gastos] / max_val * 100).round %>%"></div>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <% total_ingresos = @months.sum { |m| m[:ingresos] } %>
          <% total_gastos = @months.sum { |m| m[:gastos] } %>
          <% total_ahorro = total_ingresos - total_gastos %>
          <tr class="bg-surface-inset font-bold">
            <td class="py-3 px-3 text-primary">Media mensual</td>
            <td class="py-3 px-3 text-right text-success"><%= number_to_currency(total_ingresos / @months.size, unit: "", delimiter: ".", separator: ",") %> &euro;</td>
            <td class="py-3 px-3 text-right text-destructive"><%= number_to_currency(total_gastos / @months.size, unit: "", delimiter: ".", separator: ",") %> &euro;</td>
            <td class="py-3 px-3 text-right <%= total_ahorro >= 0 ? 'text-success' : 'text-destructive' %>"><%= total_ahorro >= 0 ? "+" : "" %><%= number_to_currency(total_ahorro / @months.size, unit: "", delimiter: ".", separator: ",") %> &euro;</td>
            <td class="py-3 px-3 text-right">
              <% avg_pct = total_ingresos > 0 ? (total_ahorro / total_ingresos * 100).round(1) : 0 %>
              <span class="text-xs px-2 py-1 rounded-full font-semibold bg-gray-100 text-gray-700"><%= avg_pct %>%</span>
            </td>
            <td class="py-3 px-3 text-right text-secondary"><%= (@months.sum { |m| m[:num_tx] }.to_f / @months.size).round %></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <%# Category breakdown %>
  <div class="bg-container shadow-border-xs rounded-xl p-4">
    <h2 class="text-lg font-medium text-primary mb-1">&iquest;En qu&eacute; se va el dinero?</h2>
    <p class="text-xs text-secondary mb-4">Media mensual de los &uacute;ltimos 3 meses</p>

    <div class="space-y-2">
      <% max_cat = @categories_breakdown.first&.dig(:mensual) || 1 %>
      <% @categories_breakdown.each do |cat| %>
        <div class="flex items-center gap-3 p-2 rounded-lg hover:bg-surface-inset transition-colors">
          <div class="w-3 h-3 rounded-full shrink-0" style="background-color: <%= cat[:color] %>"></div>
          <span class="text-sm text-primary flex-1"><%= cat[:name] %></span>
          <div class="w-32">
            <div class="h-3 bg-gray-100 rounded-full overflow-hidden">
              <div class="h-full rounded-full" style="width: <%= (cat[:mensual] / max_cat * 100).round %>%; background-color: <%= cat[:color] %>"></div>
            </div>
          </div>
          <span class="text-sm font-semibold text-primary w-24 text-right"><%= number_to_currency(cat[:mensual], unit: "", delimiter: ".", separator: ",") %> &euro;/mes</span>
          <span class="text-xs text-secondary w-12 text-right"><%= cat[:count] %> txs</span>
        </div>
      <% end %>
    </div>
  </div>
</div>
