<% content_for :breadcrumbs do %>
  <%= render "layouts/shared/breadcrumbs", breadcrumbs: [
    { label: "Accounts", href: accounts_path },
    { label: @account.name, href: account_path(@account) },
    { label: "Amortization" }
  ] %>
<% end %>

<div class="space-y-6 max-w-screen-lg mx-auto py-6">
  <h1 class="text-2xl font-bold text-primary">Amortization - <%= @account.name %></h1>

  <%# Summary cards %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <p class="text-xs text-secondary mb-1">Total intereses restantes</p>
      <p class="text-lg font-semibold text-primary"><%= number_to_currency(@total_intereses, unit: "EUR", locale: :es) %></p>
    </div>
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <p class="text-xs text-secondary mb-1">Fecha liquidaci&oacute;n estimada</p>
      <p class="text-lg font-semibold text-primary"><%= @fecha_liquidacion&.strftime("%B %Y") || "N/A" %></p>
    </div>
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <p class="text-xs text-secondary mb-1">% amortizado</p>
      <p class="text-lg font-semibold text-primary"><%= @pct_amortizado %>%</p>
    </div>
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <p class="text-xs text-secondary mb-1">Coste total del pr&eacute;stamo</p>
      <p class="text-lg font-semibold text-primary"><%= number_to_currency(@coste_total, unit: "EUR", locale: :es) %></p>
    </div>
  </div>

  <%# Amortization chart %>
  <div class="bg-container shadow-border-xs rounded-xl p-4">
    <h2 class="text-lg font-medium text-primary mb-4">Tabla de amortizaci&oacute;n</h2>
    <div data-controller="amortization-chart"
         data-amortization-chart-schedule-value="<%= @schedule.to_json %>"
         data-amortization-chart-accent-value="<%= Loan.color %>"
         class="w-full h-[400px]">
      <canvas data-amortization-chart-target="canvas"></canvas>
    </div>
  </div>

  <%# Simulator %>
  <div class="bg-container shadow-border-xs rounded-xl p-4" data-controller="loan-simulator"
       data-loan-simulator-url-value="<%= account_amortization_simulate_path(@account) %>"
       data-loan-simulator-accent-value="<%= Loan.color %>">
    <h2 class="text-lg font-medium text-primary mb-4">&iquest;Qu&eacute; pasa si...?</h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="space-y-4">
        <div>
          <label class="text-sm text-secondary block mb-2">
            Amortizaci&oacute;n anticipada: <span data-loan-simulator-target="amortLabel" class="font-semibold text-primary">0 &euro;</span>
          </label>
          <input type="range" min="0" max="<%= (@account.balance.to_f.abs * 0.5).round %>" step="500" value="0"
                 data-loan-simulator-target="amortSlider"
                 data-action="input->loan-simulator#simulate"
                 class="w-full accent-current">
        </div>
        <div>
          <label class="text-sm text-secondary block mb-2">
            Incremento cuota mensual: <span data-loan-simulator-target="cuotaLabel" class="font-semibold text-primary">+0 &euro;</span>
          </label>
          <input type="range" min="0" max="500" step="25" value="0"
                 data-loan-simulator-target="cuotaSlider"
                 data-action="input->loan-simulator#simulate"
                 class="w-full accent-current">
        </div>
      </div>

      <div class="space-y-3">
        <div class="flex justify-between items-center p-3 bg-surface-inset rounded-lg">
          <span class="text-sm text-secondary">Meses ahorrados</span>
          <span class="font-semibold text-primary" data-loan-simulator-target="mesesAhorrados">-</span>
        </div>
        <div class="flex justify-between items-center p-3 bg-surface-inset rounded-lg">
          <span class="text-sm text-secondary">Intereses ahorrados</span>
          <span class="font-semibold text-success" data-loan-simulator-target="interesesAhorrados">-</span>
        </div>
        <div class="flex justify-between items-center p-3 bg-surface-inset rounded-lg">
          <span class="text-sm text-secondary">Nueva fecha liquidaci&oacute;n</span>
          <span class="font-semibold text-primary" data-loan-simulator-target="nuevaFecha">-</span>
        </div>
      </div>
    </div>
  </div>

  <%# Amortization table %>
  <div class="bg-container shadow-border-xs rounded-xl p-4">
    <details>
      <summary class="text-lg font-medium text-primary cursor-pointer">Detalle mensual</summary>
      <div class="mt-4 max-h-[400px] overflow-y-auto">
        <table class="w-full text-sm">
          <thead class="sticky top-0 bg-container">
            <tr class="text-secondary border-b border-tertiary">
              <th class="text-left py-2 px-2">Mes</th>
              <th class="text-right py-2 px-2">Cuota</th>
              <th class="text-right py-2 px-2">Capital</th>
              <th class="text-right py-2 px-2">Intereses</th>
              <th class="text-right py-2 px-2">Pendiente</th>
            </tr>
          </thead>
          <tbody>
            <% @schedule.each do |row| %>
              <tr class="border-b border-tertiary">
                <td class="py-1.5 px-2 text-primary"><%= row[:month] %></td>
                <td class="py-1.5 px-2 text-right text-primary"><%= number_to_currency(row[:cuota], unit: "", delimiter: ".", separator: ",") %></td>
                <td class="py-1.5 px-2 text-right text-primary"><%= number_to_currency(row[:capital], unit: "", delimiter: ".", separator: ",") %></td>
                <td class="py-1.5 px-2 text-right text-secondary"><%= number_to_currency(row[:intereses], unit: "", delimiter: ".", separator: ",") %></td>
                <td class="py-1.5 px-2 text-right font-medium text-primary"><%= number_to_currency(row[:pendiente], unit: "", delimiter: ".", separator: ",") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>
  </div>

  <div class="flex justify-center">
    <%= link_to "Volver a la cuenta", account_path(@account), class: "text-sm text-secondary hover:text-primary" %>
  </div>
</div>
