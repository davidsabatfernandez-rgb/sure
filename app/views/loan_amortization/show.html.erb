<% content_for :breadcrumbs do %>
  <%= render "layouts/shared/breadcrumbs", breadcrumbs: [
    { label: "Accounts", href: accounts_path },
    { label: @account.name, href: account_path(@account) },
    { label: "Amortizaci\u00F3n" }
  ] %>
<% end %>

<div class="space-y-6 max-w-screen-lg mx-auto py-6">
  <h1 class="text-2xl font-bold text-primary">Amortizaci&oacute;n - <%= @account.name %></h1>

  <%# Summary cards %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <p class="text-xs text-secondary mb-1">Total intereses restantes</p>
      <p class="text-lg font-semibold text-destructive"><%= number_to_currency(@total_intereses, unit: "", delimiter: ".", separator: ",") %> &euro;</p>
    </div>
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <p class="text-xs text-secondary mb-1">Fecha liquidaci&oacute;n estimada</p>
      <p class="text-lg font-semibold text-primary"><%= @fecha_liquidacion&.strftime("%B %Y") || "N/A" %></p>
    </div>
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <p class="text-xs text-secondary mb-1">% amortizado</p>
      <p class="text-lg font-semibold text-success"><%= @pct_amortizado %>%</p>
    </div>
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <p class="text-xs text-secondary mb-1">Coste total del pr&eacute;stamo</p>
      <p class="text-lg font-semibold text-primary"><%= number_to_currency(@coste_total, unit: "", delimiter: ".", separator: ",") %> &euro;</p>
    </div>
  </div>

  <%# ==================== AI RECOMMENDATION ==================== %>
  <% if @analysis %>
    <div class="bg-container shadow-border-xs rounded-xl p-5 border-l-4 border-blue-500">
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center shrink-0 mt-0.5">
          <%= icon("brain", size: "sm", class: "text-blue-600") %>
        </div>
        <div>
          <h2 class="text-base font-semibold text-primary mb-2">An&aacute;lisis inteligente</h2>
          <p class="text-sm text-primary leading-relaxed"><%= @analysis[:recommendation_summary] %></p>
        </div>
      </div>
    </div>

    <%# ==================== OPPORTUNITY ANALYSIS ==================== %>
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <h2 class="text-lg font-medium text-primary mb-1">&iquest;Amortizar o invertir?</h2>
      <p class="text-xs text-secondary mb-4">Comparamos qu&eacute; pasa si usas X &euro; para amortizar vs invertirlos al <%= @analysis[:savings_rate] %>%</p>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-secondary border-b border-tertiary">
              <th class="text-left py-2 px-3">Cantidad</th>
              <th class="text-right py-2 px-3">Intereses ahorrados</th>
              <th class="text-right py-2 px-3">Ganancia invirtiendo</th>
              <th class="text-right py-2 px-3">Beneficio neto</th>
              <th class="text-right py-2 px-3">Meses ahorrados</th>
              <th class="text-center py-2 px-3">Veredicto</th>
            </tr>
          </thead>
          <tbody>
            <% @analysis[:opportunity_analysis].each do |opp| %>
              <tr class="border-b border-tertiary">
                <td class="py-2 px-3 font-medium text-primary"><%= number_to_currency(opp[:amount], unit: "", delimiter: ".", separator: ",") %> &euro;</td>
                <td class="py-2 px-3 text-right text-success"><%= number_to_currency(opp[:interest_saved], unit: "", delimiter: ".", separator: ",") %> &euro;</td>
                <td class="py-2 px-3 text-right text-blue-600"><%= number_to_currency(opp[:investment_earned], unit: "", delimiter: ".", separator: ",") %> &euro;</td>
                <td class="py-2 px-3 text-right font-semibold <%= opp[:net_benefit] > 0 ? 'text-success' : 'text-destructive' %>">
                  <%= opp[:net_benefit] > 0 ? "+" : "" %><%= number_to_currency(opp[:net_benefit], unit: "", delimiter: ".", separator: ",") %> &euro;
                </td>
                <td class="py-2 px-3 text-right text-primary"><%= opp[:months_saved] %></td>
                <td class="py-2 px-3 text-center">
                  <% if opp[:recommendation] == "amortizar" %>
                    <span class="text-xs px-2 py-1 bg-green-100 text-green-800 rounded-full font-medium">Amortizar</span>
                  <% else %>
                    <span class="text-xs px-2 py-1 bg-blue-100 text-blue-800 rounded-full font-medium">Invertir</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @analysis[:other_loans].any? %>
        <div class="mt-4 p-3 bg-yellow-50 rounded-lg border border-yellow-200">
          <p class="text-sm text-yellow-800 font-medium mb-1">Otros pr&eacute;stamos activos:</p>
          <% @analysis[:other_loans].each do |ol| %>
            <p class="text-sm text-yellow-700">
              &bull; <%= ol[:name] %>: <%= number_to_currency(ol[:balance], unit: "", delimiter: ".", separator: ",") %> &euro; al <%= ol[:rate] %>%
              <% if ol[:rate] && ol[:rate] > @analysis[:loan_rate] %>
                <span class="text-xs px-1.5 py-0.5 bg-red-100 text-red-700 rounded-full ml-1">Prioridad</span>
              <% end %>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# ==================== CAPITAL VS INTEREST TABLE ==================== %>
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <h2 class="text-lg font-medium text-primary mb-4">Capital vs Inter&eacute;s por a&ntilde;o</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-secondary border-b border-tertiary">
              <th class="text-left py-2 px-3">A&ntilde;o</th>
              <th class="text-right py-2 px-3">Capital pagado</th>
              <th class="text-right py-2 px-3">Intereses pagados</th>
              <th class="text-right py-2 px-3">% inter&eacute;s</th>
              <th class="text-right py-2 px-3">Capital pendiente</th>
              <th class="text-left py-2 px-3">Proporci&oacute;n</th>
            </tr>
          </thead>
          <tbody>
            <% @analysis[:interest_by_year].each do |yr| %>
              <tr class="border-b border-tertiary">
                <td class="py-2 px-3 font-medium text-primary"><%= yr[:year] %></td>
                <td class="py-2 px-3 text-right text-success"><%= number_to_currency(yr[:total_capital], unit: "", delimiter: ".", separator: ",") %></td>
                <td class="py-2 px-3 text-right text-destructive"><%= number_to_currency(yr[:total_interest], unit: "", delimiter: ".", separator: ",") %></td>
                <td class="py-2 px-3 text-right text-secondary"><%= yr[:interest_pct] %>%</td>
                <td class="py-2 px-3 text-right font-medium text-primary"><%= number_to_currency(yr[:pending], unit: "", delimiter: ".", separator: ",") %></td>
                <td class="py-2 px-3">
                  <div class="flex h-4 rounded-full overflow-hidden w-24">
                    <div class="bg-green-500" style="width: <%= 100 - yr[:interest_pct] %>%"></div>
                    <div class="bg-red-300" style="width: <%= yr[:interest_pct] %>%"></div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="flex items-center gap-4 mt-3 text-xs text-secondary">
        <div class="flex items-center gap-1"><div class="w-3 h-3 rounded-full bg-green-500"></div> Capital</div>
        <div class="flex items-center gap-1"><div class="w-3 h-3 rounded-full bg-red-300"></div> Inter&eacute;s</div>
        <% if @analysis[:crossover_month] %>
          <span class="ml-auto text-primary font-medium">Punto de cruce capital > inter&eacute;s: mes <%= @analysis[:crossover_month] %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ==================== AMORTIZATION CHART ==================== %>
  <div class="bg-container shadow-border-xs rounded-xl p-4">
    <h2 class="text-lg font-medium text-primary mb-4">Gr&aacute;fico de amortizaci&oacute;n</h2>
    <div data-controller="amortization-chart"
         data-amortization-chart-schedule-value="<%= @schedule.to_json %>"
         data-amortization-chart-accent-value="<%= Loan.color %>"
         class="w-full h-[400px]">
    </div>
  </div>

  <%# ==================== SIMULATOR ==================== %>
  <div class="bg-container shadow-border-xs rounded-xl p-4" data-controller="loan-simulator"
       data-loan-simulator-url-value="<%= account_amortization_simulate_path(@account) %>"
       data-loan-simulator-accent-value="<%= Loan.color %>">
    <h2 class="text-lg font-medium text-primary mb-4">&iquest;Qu&eacute; pasa si...?</h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="space-y-4">
        <div>
          <label class="text-sm text-secondary block mb-2">
            Amortizaci&oacute;n anticipada: <span data-loan-simulator-target="amortLabel" class="font-semibold text-primary">0 &euro;</span>
          </label>
          <input type="range" min="0" max="<%= (@account.balance.to_f.abs * 0.5).round %>" step="500" value="0"
                 data-loan-simulator-target="amortSlider"
                 data-action="input->loan-simulator#simulate"
                 class="w-full accent-current">
        </div>
        <div>
          <label class="text-sm text-secondary block mb-2">
            Incremento cuota mensual: <span data-loan-simulator-target="cuotaLabel" class="font-semibold text-primary">+0 &euro;</span>
          </label>
          <input type="range" min="0" max="500" step="25" value="0"
                 data-loan-simulator-target="cuotaSlider"
                 data-action="input->loan-simulator#simulate"
                 class="w-full accent-current">
        </div>
      </div>

      <div class="space-y-3">
        <div class="flex justify-between items-center p-3 bg-surface-inset rounded-lg">
          <span class="text-sm text-secondary">Meses ahorrados</span>
          <span class="font-semibold text-primary" data-loan-simulator-target="mesesAhorrados">-</span>
        </div>
        <div class="flex justify-between items-center p-3 bg-surface-inset rounded-lg">
          <span class="text-sm text-secondary">Intereses ahorrados</span>
          <span class="font-semibold text-success" data-loan-simulator-target="interesesAhorrados">-</span>
        </div>
        <div class="flex justify-between items-center p-3 bg-surface-inset rounded-lg">
          <span class="text-sm text-secondary">Nueva fecha liquidaci&oacute;n</span>
          <span class="font-semibold text-primary" data-loan-simulator-target="nuevaFecha">-</span>
        </div>
      </div>
    </div>
  </div>

  <%# ==================== MONTHLY DETAIL ==================== %>
  <div class="bg-container shadow-border-xs rounded-xl p-4">
    <details>
      <summary class="text-lg font-medium text-primary cursor-pointer">Detalle mensual</summary>
      <div class="mt-4 max-h-[400px] overflow-y-auto">
        <table class="w-full text-sm">
          <thead class="sticky top-0 bg-container">
            <tr class="text-secondary border-b border-tertiary">
              <th class="text-left py-2 px-2">Mes</th>
              <th class="text-right py-2 px-2">Cuota</th>
              <th class="text-right py-2 px-2">Capital</th>
              <th class="text-right py-2 px-2">Intereses</th>
              <th class="text-right py-2 px-2">Pendiente</th>
            </tr>
          </thead>
          <tbody>
            <% @schedule.each do |row| %>
              <tr class="border-b border-tertiary">
                <td class="py-1.5 px-2 text-primary"><%= row[:month] %></td>
                <td class="py-1.5 px-2 text-right text-primary"><%= number_to_currency(row[:cuota], unit: "", delimiter: ".", separator: ",") %></td>
                <td class="py-1.5 px-2 text-right text-success"><%= number_to_currency(row[:capital], unit: "", delimiter: ".", separator: ",") %></td>
                <td class="py-1.5 px-2 text-right text-destructive"><%= number_to_currency(row[:intereses], unit: "", delimiter: ".", separator: ",") %></td>
                <td class="py-1.5 px-2 text-right font-medium text-primary"><%= number_to_currency(row[:pendiente], unit: "", delimiter: ".", separator: ",") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>
  </div>

  <div class="flex justify-center">
    <%= link_to "Volver a la cuenta", account_path(@account), class: "text-sm text-secondary hover:text-primary" %>
  </div>
</div>
