<% content_for :breadcrumbs do %>
  <%= render "layouts/shared/breadcrumbs", breadcrumbs: [{ label: "Dashboard", href: root_path }, { label: "Ingresos pasivos" }] %>
<% end %>

<div class="space-y-6 max-w-screen-lg mx-auto py-6">
  <h1 class="text-2xl font-bold text-primary">Ingresos pasivos</h1>

  <%# Summary %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <p class="text-xs text-secondary mb-1">Ingresos pasivos/mes</p>
      <p class="text-xl font-bold text-success"><%= number_to_currency(@total_passive, unit: "", delimiter: ".", separator: ",") %> &euro;</p>
    </div>
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <p class="text-xs text-secondary mb-1">Alquiler</p>
      <p class="text-xl font-bold text-primary"><%= number_to_currency(@rental_income, unit: "", delimiter: ".", separator: ",") %> &euro;/mes</p>
    </div>
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <p class="text-xs text-secondary mb-1">Intereses remuneradas</p>
      <p class="text-xl font-bold text-primary"><%= number_to_currency(@interest_monthly, unit: "", delimiter: ".", separator: ",") %> &euro;/mes</p>
    </div>
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <p class="text-xs text-secondary mb-1">Cobertura de gastos</p>
      <p class="text-xl font-bold <%= @coverage_pct >= 100 ? 'text-success' : @coverage_pct >= 50 ? 'text-warning' : 'text-destructive' %>"><%= @coverage_pct %>%</p>
    </div>
  </div>

  <%# Coverage bar %>
  <div class="bg-container shadow-border-xs rounded-xl p-4">
    <h2 class="text-base font-medium text-primary mb-3">Independencia financiera</h2>
    <p class="text-sm text-secondary mb-2">
      Necesitas <span class="font-semibold text-primary"><%= number_to_currency(@goal_monthly, unit: "", delimiter: ".", separator: ",") %> &euro;/mes</span> para cubrir gastos.
      Tienes <span class="font-semibold text-success"><%= number_to_currency(@total_passive, unit: "", delimiter: ".", separator: ",") %> &euro;/mes</span> en pasivos.
      <% if @gap > 0 %>
        Te faltan <span class="font-semibold text-destructive"><%= number_to_currency(@gap, unit: "", delimiter: ".", separator: ",") %> &euro;/mes</span>.
      <% end %>
    </p>
    <div class="h-6 bg-gray-200 rounded-full overflow-hidden">
      <div class="h-full bg-green-500 rounded-full flex items-center justify-center text-white text-xs font-medium transition-all" style="width: <%= [@coverage_pct, 100].min %>%">
        <%= @coverage_pct %>%
      </div>
    </div>
    <% if @gap > 0 %>
      <p class="text-xs text-secondary mt-2">
        Con la Iglesia Rom&aacute;nica alquilada (+2.050&euro;/mes), llegar&iacute;as a un <span class="font-semibold"><%= ((@total_passive + 2050) / @monthly_expenses * 100).round(0) %>%</span> de cobertura.
      </p>
    <% end %>
  </div>

  <%# Breakdown by source %>
  <div class="bg-container shadow-border-xs rounded-xl p-4">
    <h2 class="text-lg font-medium text-primary mb-4">Desglose por fuente</h2>

    <% if @properties.any? %>
      <h3 class="text-sm font-semibold text-secondary uppercase tracking-wide mb-3">Alquileres</h3>
      <div class="space-y-2 mb-4">
        <% @properties.each do |prop| %>
          <div class="flex items-center justify-between p-3 bg-surface-inset rounded-lg">
            <div class="flex items-center gap-2">
              <%= icon("home", size: "sm", class: "text-secondary") %>
              <span class="text-sm text-primary"><%= prop.name %></span>
            </div>
            <div class="text-right">
              <% renta = prop.accountable.renta_mensual || 0 %>
              <% if renta > 0 %>
                <span class="font-medium text-success"><%= number_to_currency(renta, unit: "", delimiter: ".", separator: ",") %> &euro;/mes</span>
              <% else %>
                <span class="text-xs text-secondary">Sin alquiler configurado</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <h3 class="text-sm font-semibold text-secondary uppercase tracking-wide mb-3">Intereses</h3>
    <div class="flex items-center justify-between p-3 bg-surface-inset rounded-lg">
      <div class="flex items-center gap-2">
        <%= icon("percent", size: "sm", class: "text-secondary") %>
        <span class="text-sm text-primary">Cuentas remuneradas (2% TIN)</span>
      </div>
      <span class="font-medium text-success"><%= number_to_currency(@interest_monthly, unit: "", delimiter: ".", separator: ",") %> &euro;/mes</span>
    </div>
  </div>
</div>
