<% content_for :breadcrumbs do %>
  <%= render "layouts/shared/breadcrumbs", breadcrumbs: [
    { label: "Dashboard", href: root_path },
    { label: "Patrimonio" }
  ] %>
<% end %>

<div class="space-y-6 max-w-screen-lg mx-auto py-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-primary">Patrimonio neto</h1>
    <%= button_to save_snapshot_patrimonio_path, method: :post, class: "inline-flex items-center gap-2 px-4 py-2 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800 transition-colors" do %>
      <%= icon("camera", size: "sm") %>
      Guardar snapshot hoy
    <% end %>
  </div>

  <%# Big number %>
  <div class="bg-container shadow-border-xs rounded-xl p-8 text-center">
    <p class="text-sm text-secondary mb-2">Patrimonio neto total</p>
    <p class="text-4xl font-bold <%= @net_worth >= 0 ? 'text-success' : 'text-destructive' %>">
      <%= format_money(@net_worth) %>
    </p>
    <% if @previous_snapshot %>
      <% nw_val = @net_worth.respond_to?(:amount) ? @net_worth.amount : @net_worth.to_f %>
      <% diff = nw_val - @previous_snapshot.patrimonio_neto %>
      <% diff_pct = @previous_snapshot.patrimonio_neto != 0 ? (diff / @previous_snapshot.patrimonio_neto * 100).round(1) : 0 %>
      <p class="text-sm mt-2 <%= diff >= 0 ? 'text-success' : 'text-destructive' %>">
        <%= diff >= 0 ? "+" : "" %><%= number_to_currency(diff, unit: "", delimiter: ".", separator: ",") %> EUR
        (<%= diff >= 0 ? "+" : "" %><%= diff_pct %>%)
        vs &uacute;ltimo snapshot (<%= @previous_snapshot.fecha.strftime("%d/%m/%Y") %>)
      </p>
    <% end %>
  </div>

  <%# Assets vs Liabilities breakdown %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <%# Assets %>
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-medium text-primary">Activos</h2>
        <p class="text-lg font-bold text-success"><%= format_money(@assets.total) %></p>
      </div>
      <div class="space-y-2">
        <% @assets.account_groups.each do |group| %>
          <div class="flex justify-between items-center p-2 bg-surface-inset rounded-lg">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full" style="background-color: <%= group.color %>"></div>
              <span class="text-sm text-primary"><%= group.name %></span>
            </div>
            <span class="text-sm font-medium text-primary"><%= format_money(group.total) %></span>
          </div>
        <% end %>
      </div>
    </div>

    <%# Liabilities %>
    <div class="bg-container shadow-border-xs rounded-xl p-4">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-medium text-primary">Pasivos</h2>
        <p class="text-lg font-bold text-destructive"><%= format_money(@liabilities.total) %></p>
      </div>
      <div class="space-y-2">
        <% @liabilities.account_groups.each do |group| %>
          <div class="flex justify-between items-center p-2 bg-surface-inset rounded-lg">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full" style="background-color: <%= group.color %>"></div>
              <span class="text-sm text-primary"><%= group.name %></span>
            </div>
            <span class="text-sm font-medium text-primary"><%= format_money(group.total) %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Leverage ratio bar %>
  <div class="bg-container shadow-border-xs rounded-xl p-4">
    <h2 class="text-lg font-medium text-primary mb-3">Ratio activos / pasivos</h2>
    <% assets_val = @assets.total.respond_to?(:amount) ? @assets.total.amount : @assets.total.to_f %>
    <% liabilities_val = @liabilities.total.respond_to?(:amount) ? @liabilities.total.amount.abs : @liabilities.total.to_f.abs %>
    <% total = assets_val + liabilities_val %>
    <% assets_pct = total > 0 ? (assets_val / total * 100).round(1) : 100 %>
    <% liabilities_pct = 100 - assets_pct %>
    <div class="flex h-8 rounded-lg overflow-hidden">
      <div class="bg-green-500 flex items-center justify-center text-white text-xs font-medium" style="width: <%= assets_pct %>%">
        Activos <%= assets_pct %>%
      </div>
      <% if liabilities_pct > 0 %>
        <div class="bg-red-400 flex items-center justify-center text-white text-xs font-medium" style="width: <%= liabilities_pct %>%">
          Pasivos <%= liabilities_pct %>%
        </div>
      <% end %>
    </div>
  </div>

  <%# Historical snapshots %>
  <div class="bg-container shadow-border-xs rounded-xl p-4">
    <h2 class="text-lg font-medium text-primary mb-4">Hist&oacute;rico de patrimonio</h2>

    <% if @snapshots.any? %>
      <div class="mb-4" data-controller="time-series-chart"
           data-time-series-chart-data-value="<%= {
             values: @snapshots.map { |s| { date: s.fecha.to_s, value: s.patrimonio_neto.to_f, trend: { type: 'normal', color: s.patrimonio_neto >= 0 ? '#12B76A' : '#F13636' } } }
           }.to_json %>"
           style="height: 300px">
      </div>

      <div class="max-h-[300px] overflow-y-auto">
        <table class="w-full text-sm">
          <thead class="sticky top-0 bg-container">
            <tr class="text-secondary border-b border-tertiary">
              <th class="text-left py-2 px-2">Fecha</th>
              <th class="text-right py-2 px-2">Activos</th>
              <th class="text-right py-2 px-2">Pasivos</th>
              <th class="text-right py-2 px-2">Patrimonio neto</th>
            </tr>
          </thead>
          <tbody>
            <% @snapshots.reverse.each do |snap| %>
              <tr class="border-b border-tertiary">
                <td class="py-1.5 px-2 text-primary"><%= snap.fecha.strftime("%d/%m/%Y") %></td>
                <td class="py-1.5 px-2 text-right text-success"><%= number_to_currency(snap.activos, unit: "", delimiter: ".", separator: ",") %></td>
                <td class="py-1.5 px-2 text-right text-destructive"><%= number_to_currency(snap.pasivos, unit: "", delimiter: ".", separator: ",") %></td>
                <td class="py-1.5 px-2 text-right font-medium <%= snap.patrimonio_neto >= 0 ? 'text-success' : 'text-destructive' %>"><%= number_to_currency(snap.patrimonio_neto, unit: "", delimiter: ".", separator: ",") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-secondary text-sm p-4 text-center">No hay snapshots a&uacute;n. Pulsa "Guardar snapshot hoy" para empezar a registrar tu patrimonio.</p>
    <% end %>
  </div>
</div>
