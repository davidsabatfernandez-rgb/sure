<% today_spent = Current.family.today_spending %>
<% month_spent = Current.family.month_spending %>
<% avg_spending = Current.family.average_monthly_spending(3) %>
<% month_budget = avg_spending > 0 ? avg_spending.round(0) : 1500 %>
<% month_income_val = Current.family.month_income %>
<% month_saved = Current.family.month_savings %>
<% budget_pct = month_budget.zero? ? 0 : [(month_spent / month_budget.to_f * 100).round, 100].min %>
<% savings_pct = month_income_val > 0 ? [(month_saved / month_income_val.to_f * 100).clamp(0, 100).round, 100].min : 0 %>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <%# Today's spending %>
  <div class="bg-container rounded-xl shadow-border-xs p-4">
    <div class="flex items-center gap-2 mb-1">
      <%= icon("shopping-cart", size: "sm", color: "current", class: "text-secondary") %>
      <span class="text-sm text-secondary">Hoy has gastado</span>
    </div>
    <p class="text-2xl font-semibold <%= today_spent > 100 ? 'text-destructive' : 'text-primary' %>">
      <%= number_to_currency(today_spent, unit: "", delimiter: ".", separator: ",") %> &euro;
    </p>
  </div>

  <%# Monthly spending vs average %>
  <div class="bg-container rounded-xl shadow-border-xs p-4">
    <div class="flex items-center gap-2 mb-1">
      <%= icon("wallet", size: "sm", color: "current", class: "text-secondary") %>
      <span class="text-sm text-secondary">Este mes llevas</span>
    </div>
    <p class="text-2xl font-semibold text-primary">
      <%= number_to_currency(month_spent, unit: "", delimiter: ".", separator: ",") %> &euro;
      <span class="text-sm font-normal text-secondary">de ~<%= number_to_currency(month_budget, unit: "", delimiter: ".", separator: ",") %>&euro; media</span>
    </p>
    <div class="mt-2 w-full bg-gray-200 rounded-full h-2">
      <div class="<%= budget_pct >= 90 ? 'bg-red-500' : budget_pct >= 70 ? 'bg-yellow-500' : 'bg-green-500' %> h-2 rounded-full transition-all" style="width: <%= budget_pct %>%"></div>
    </div>
    <p class="text-xs text-secondary mt-1"><%= budget_pct %>% vs tu media mensual</p>
  </div>

  <%# Monthly savings %>
  <div class="bg-container rounded-xl shadow-border-xs p-4">
    <div class="flex items-center gap-2 mb-1">
      <%= icon("piggy-bank", size: "sm", color: "current", class: "text-secondary") %>
      <span class="text-sm text-secondary">Ahorrado este mes</span>
    </div>
    <% if month_income_val > 0 %>
      <p class="text-2xl font-semibold <%= month_saved >= 0 ? 'text-success' : 'text-destructive' %>">
        <%= number_to_currency(month_saved.abs, unit: "", delimiter: ".", separator: ",") %> &euro;
        <span class="text-sm font-normal text-secondary">(<%= savings_pct %>% del ingreso)</span>
      </p>
    <% else %>
      <p class="text-2xl font-semibold text-secondary">Sin n&oacute;mina a&uacute;n</p>
    <% end %>
    <% if month_income_val > 0 %>
      <div class="mt-2 w-full bg-gray-200 rounded-full h-2">
        <div class="bg-green-500 h-2 rounded-full transition-all" style="width: <%= savings_pct %>%"></div>
      </div>
    <% end %>
  </div>
</div>
