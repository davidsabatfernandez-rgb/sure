<% today_spent = Current.family.today_spending %>
<% month_spent = Current.family.month_spending %>
<% month_budget = FamilyFinancialSummary::DEFAULT_MONTHLY_BUDGET %>
<% month_saved = Current.family.month_savings %>
<% savings_goal = FamilyFinancialSummary::DEFAULT_SAVINGS_GOAL %>
<% budget_pct = month_budget.zero? ? 0 : [(month_spent / month_budget.to_f * 100).round, 100].min %>
<% savings_pct = savings_goal.zero? ? 0 : [(month_saved / savings_goal.to_f * 100).clamp(0, 100).round, 100].min %>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <%# Today's spending %>
  <div class="bg-container rounded-xl shadow-border-xs p-4">
    <div class="flex items-center gap-2 mb-1">
      <%= icon("shopping-cart", size: "sm", color: "current", class: "text-secondary") %>
      <span class="text-sm text-secondary">Hoy has gastado</span>
    </div>
    <p class="text-2xl font-semibold text-primary">
      <%= format_money(today_spent, { currency: Current.family.currency }) %>
    </p>
  </div>

  <%# Monthly spending vs budget %>
  <div class="bg-container rounded-xl shadow-border-xs p-4">
    <div class="flex items-center gap-2 mb-1">
      <%= icon("wallet", size: "sm", color: "current", class: "text-secondary") %>
      <span class="text-sm text-secondary">Este mes llevas</span>
    </div>
    <p class="text-2xl font-semibold text-primary">
      <%= format_money(month_spent, { currency: Current.family.currency }) %>
      <span class="text-sm font-normal text-secondary">de <%= number_to_currency(month_budget, unit: "", delimiter: ".", separator: ",") %>&euro;</span>
    </p>
    <div class="mt-2 w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
      <div class="<%= budget_pct >= 90 ? 'bg-red-500' : budget_pct >= 70 ? 'bg-yellow-500' : 'bg-green-500' %> h-2.5 rounded-full transition-all duration-300" style="width: <%= budget_pct %>%"></div>
    </div>
    <p class="text-xs text-secondary mt-1"><%= budget_pct %>% del presupuesto</p>
  </div>

  <%# Monthly savings %>
  <div class="bg-container rounded-xl shadow-border-xs p-4">
    <div class="flex items-center gap-2 mb-1">
      <%= icon("piggy-bank", size: "sm", color: "current", class: "text-secondary") %>
      <span class="text-sm text-secondary">Ahorrado este mes</span>
    </div>
    <p class="text-2xl font-semibold <%= month_saved >= 0 ? 'text-success' : 'text-destructive' %>">
      <%= format_money(month_saved.abs, { currency: Current.family.currency }) %>
      <span class="text-sm font-normal text-secondary">de <%= number_to_currency(savings_goal, unit: "", delimiter: ".", separator: ",") %>&euro;</span>
    </p>
    <div class="mt-2 w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5">
      <div class="bg-green-500 h-2.5 rounded-full transition-all duration-300" style="width: <%= savings_pct %>%"></div>
    </div>
    <p class="text-xs text-secondary mt-1"><%= savings_pct %>% del objetivo</p>
  </div>
</div>
