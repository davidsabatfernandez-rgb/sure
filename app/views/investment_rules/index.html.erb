<%= content_for :page_title, t(".title") %>

<div class="space-y-4">
  <%# Monthly summary banner %>
  <div class="bg-container rounded-xl shadow-border-xs p-6">
    <div class="flex items-center gap-3 mb-2">
      <%= icon("trending-up", size: "md") %>
      <h2 class="text-lg font-medium text-primary"><%= t(".monthly_summary") %></h2>
    </div>
    <p class="text-2xl font-semibold text-primary">
      <%= number_to_currency(@monthly_total, unit: Current.family.currency + " ") %>
    </p>
    <p class="text-sm text-secondary mt-1"><%= t(".monthly_explanation") %></p>
  </div>

  <%# Add new rule form %>
  <div class="bg-container rounded-xl shadow-border-xs p-6">
    <h3 class="text-lg font-medium text-primary mb-4"><%= t(".new_rule") %></h3>

    <%= styled_form_with model: @investment_rule, url: investment_rules_path, class: "space-y-4" do |f| %>
      <% if @investment_rule.errors.any? %>
        <%= render "shared/form_errors", model: @investment_rule %>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <%= f.select :category_id,
              @categories.map { |c| [c.name, c.id] },
              { include_blank: t(".select_category"), label: t(".category") } %>

        <%= f.number_field :percentage,
              min: 1, max: 100, step: 1,
              label: t(".percentage"),
              placeholder: "10" %>

        <%= f.select :target_type,
              InvestmentRule::TARGET_TYPES.map { |t_type| [t(".target_types.#{t_type}"), t_type] },
              { label: t(".target") } %>
      </div>

      <div class="flex justify-end">
        <%= f.submit t(".add_rule"), class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>

  <%# Active rules list %>
  <div class="bg-container rounded-xl shadow-border-xs p-6">
    <h3 class="text-lg font-medium text-primary mb-4"><%= t(".active_rules") %></h3>

    <% if @investment_rules.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-primary">
              <th class="text-left text-sm text-secondary py-3 px-2"><%= t(".table.category") %></th>
              <th class="text-left text-sm text-secondary py-3 px-2"><%= t(".table.percentage") %></th>
              <th class="text-left text-sm text-secondary py-3 px-2"><%= t(".table.target") %></th>
              <th class="text-right text-sm text-secondary py-3 px-2"><%= t(".table.spent_this_month") %></th>
              <th class="text-right text-sm text-secondary py-3 px-2"><%= t(".table.to_invest") %></th>
              <th class="text-right text-sm text-secondary py-3 px-2"><%= t(".table.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @investment_rules.each do |rule| %>
              <% summary_row = @summary.find { |s| s[:category_name] == rule.category.name } %>
              <tr class="border-b border-primary last:border-b-0">
                <td class="py-3 px-2">
                  <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-full" style="background-color: <%= rule.category.color %>"></div>
                    <span class="text-sm text-primary"><%= rule.category.name %></span>
                  </div>
                </td>
                <td class="py-3 px-2 text-sm text-primary"><%= rule.percentage %>%</td>
                <td class="py-3 px-2 text-sm text-primary"><%= t(".target_types.#{rule.target_type}") %></td>
                <td class="py-3 px-2 text-sm text-primary text-right">
                  <%= number_to_currency(summary_row&.dig(:spent) || 0, unit: Current.family.currency + " ") %>
                </td>
                <td class="py-3 px-2 text-sm font-medium text-primary text-right">
                  <%= number_to_currency(summary_row&.dig(:to_invest) || 0, unit: Current.family.currency + " ") %>
                </td>
                <td class="py-3 px-2 text-right">
                  <%= button_to t(".delete"),
                        investment_rule_path(rule),
                        method: :delete,
                        class: "text-sm text-destructive hover:underline",
                        data: { turbo_confirm: t(".confirm_delete") } %>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="border-t-2 border-primary">
              <td colspan="4" class="py-3 px-2 text-sm font-semibold text-primary text-right"><%= t(".table.total") %></td>
              <td class="py-3 px-2 text-sm font-semibold text-primary text-right">
                <%= number_to_currency(@monthly_total, unit: Current.family.currency + " ") %>
              </td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% else %>
      <div class="flex justify-center items-center py-12">
        <p class="text-sm text-secondary"><%= t(".empty") %></p>
      </div>
    <% end %>
  </div>
</div>
